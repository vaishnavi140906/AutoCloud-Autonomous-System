# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/autocloud?retryWrites=true&w=majority
# If left empty, the server will automatically start an in-memory MongoDB instance for zero-friction local testing.
MONGODB_URI=

# JWT Secret & Expiration
JWT_SECRET=autocloud_super_secret_jwt_key_2026_production
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Telemetry Simulator Parameters
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=3000
