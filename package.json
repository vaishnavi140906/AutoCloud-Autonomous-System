{
  "name": "autocloud-autonomous-systems",
  "version": "1.0.0",
  "description": "AutoCloud – Cloud-Based Autonomous System Management Platform",
  "main": "server/server.js",
  "scripts": {
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "keywords": [
    "cloud-computing",
    "autonomous-systems",
    "telemetry",
    "iot",
    "robotics",
    "react",
    "nodejs",
    "mongodb",
    "socketio"
  ],
  "author": "AutoCloud Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
